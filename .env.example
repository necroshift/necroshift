# Postgres (docker-compose.yml maps the container's 5432 to 5433 on the
# host — something else on this machine is already using 5432).
DATABASE_URL=postgres://necroshift:necroshift@localhost:5433/necroshift

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app (login + the repo access the self-heal pipeline reuses)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AES-GCM key (32 random bytes, base64) used to encrypt provider_credential rows
ENCRYPTION_KEY=
