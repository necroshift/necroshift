# Postgres (docker-compose.yml maps the container's 5432 to 5433 on the
# host — something else on this machine is already using 5432).
DATABASE_URL=postgres://necroshift:necroshift@localhost:5433/necroshift

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app (login + the repo access the self-heal pipeline reuses)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AES-GCM key (32 random bytes, base64) used to encrypt provider_credential rows
ENCRYPTION_KEY=

# Self-heal pipeline: the sandbox-runner compose service. localhost:4000
# is its host-published port, used while `web` runs on the host via
# `pnpm dev`. If `web` is itself ever containerized on the compose
# network, point this at http://sandbox-runner:4000 instead.
SANDBOX_RUNNER_URL=http://localhost:4000
# Shared secret between `web` and sandbox-runner — sandbox-runner owns the
# Docker socket and will launch a sandbox with whatever credentials a
# POST /runs request hands it, so this must not be guessable. Generate with:
#   openssl rand -base64 32
SANDBOX_RUNNER_SECRET=

# Jira Cloud OAuth 2.0 (3LO) app, and Linear OAuth2 app — Settings →
# Connections. Redirect URIs to register:
#   {BETTER_AUTH_URL}/api/connections/jira/callback
#   {BETTER_AUTH_URL}/api/connections/linear/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
